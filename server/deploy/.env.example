# server/deploy production environment — copy to .env and fill in, then run
# `docker compose up -d --build` from this directory.
#
# .env is git-ignored (KEEP IT OUT OF GIT). If it is ever committed or
# leaked, rotate the secrets below.
#
# docker-compose.yml interpolates the POSTGRES_* / NEXTDO_OWNER_TOKEN /
# JWT_SECRET / PS_ADMIN_TOKEN values; the PowerSync service resolves the
# PS_* values via its own `!env` tag in service.yaml.

# Postgres — one instance, two databases: POSTGRES_DB (the app's source DB
# that /upload writes to) and the FIXED name nextdo_powersync (the PowerSync
# bucket storage DB, created by the init script). Use a strong password.
POSTGRES_USER=nextdo
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DB=nextdo
# Debug port on the host's loopback (psql only; nothing else uses it).
# Change if the host already runs another Postgres on 5432.
POSTGRES_HOST_PORT=5432

# The single v1 owner token — REQUIRED. Generate it ONCE (deploy-owned):
#   openssl rand -hex 32
# and paste the 64-hex value in below. The server refuses to start when
# the value is missing or empty. Every device enters this SAME value in
# the Settings tab (Cloud sync). The token lives ONLY in this .env — no
# file, no log line, no API echo — so a leaked .env compromises EVERY
# device at once (same severity as the other secrets in this file).
NEXTDO_OWNER_TOKEN=REPLACE_WITH_64_HEX_TOKEN

# The PUBLIC sync-stream URL — REQUIRED since 10-02. The api refuses to
# start when it is missing, empty, or not an absolute http(s) URL.
#
# Fill in the URL your reverse proxy serves the PowerSync service under —
# the SAME value you would type into a device's Settings tab as
# 「同步流地址」:
#   single domain with prefixes : https://your.domain/sync
#   subdomains                  : https://sync.your.domain
# NOT the container's 127.0.0.1:8080 — that address is unreachable from a
# device. The server hands this value to every device through
# GET /credentials, so you set it once here and each device only types
# your server address (see README "Connect a device").
#
# UPGRADING an existing deployment? Set this BEFORE `docker compose up`
# — the api container refuses to boot without it.
NEXTDO_SYNC_ENDPOINT=REPLACE_WITH_PUBLIC_SYNC_URL

# PowerSync JWT shared secret — base64url-encoded, NO padding.
# ONE secret: server/app signs the /credentials JWT with it AND the PowerSync
# service verifies it (PS_JWT_SECRET). A mismatch = clients never sync.
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
JWT_SECRET=REPLACE_WITH_BASE64URL_SECRET

# PowerSync admin API / CLI token (local ops only — never exposed publicly).
#   openssl rand -hex 32
PS_ADMIN_TOKEN=REPLACE_WITH_ADMIN_TOKEN
