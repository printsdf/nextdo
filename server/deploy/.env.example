# server/deploy production environment — copy to .env and fill in, then run
# `docker compose up -d --build` from this directory.
#
# .env is git-ignored (KEEP IT OUT OF GIT). If it is ever committed or
# leaked, rotate the secrets below.
#
# docker-compose.yml interpolates the POSTGRES_* / NEXTDO_OWNER_TOKEN /
# JWT_SECRET / PS_ADMIN_TOKEN values; the PowerSync service resolves the
# PS_* values via its own `!env` tag in service.yaml.

# Postgres — one instance, two databases: POSTGRES_DB (the app's source DB
# that /upload writes to) and the FIXED name nextdo_powersync (the PowerSync
# bucket storage DB, created by the init script). Use a strong password.
POSTGRES_USER=nextdo
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DB=nextdo
# Debug port on the host's loopback (psql only; nothing else uses it).
# Change if the host already runs another Postgres on 5432.
POSTGRES_HOST_PORT=5432

# The single v1 owner token — the credential every device enters in the
# Settings tab (Cloud sync). Two ways to provide it:
#   A) Generate one yourself and set it here (explicit):
#       openssl rand -hex 32
#      The token is fixed; `POST /claim` always answers 409 (reason
#      "explicit") and NEVER serves this value.
#   B) Leave it EMPTY (or omit the line): the server boots UNCLAIMED
#      (no token is generated or printed at startup — it never appears
#      in any log). The FIRST device to connect with an empty token
#      triggers `POST /claim`: the server mints a 64-hex token,
#      persists it in ./data/owner-token, and returns it to THAT
#      device only (the one-time 200 body is the token's only display
#      path). Every later claim is 409 (reason "file"); later devices
#      enter the token manually (it is the file's content).
# Once devices are connected, prefer A) so the token survives a lost
# ./data directory.
NEXTDO_OWNER_TOKEN=

# PowerSync JWT shared secret — base64url-encoded, NO padding.
# ONE secret: server/app signs the /credentials JWT with it AND the PowerSync
# service verifies it (PS_JWT_SECRET). A mismatch = clients never sync.
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
JWT_SECRET=REPLACE_WITH_BASE64URL_SECRET

# PowerSync admin API / CLI token (local ops only — never exposed publicly).
#   openssl rand -hex 32
PS_ADMIN_TOKEN=REPLACE_WITH_ADMIN_TOKEN
