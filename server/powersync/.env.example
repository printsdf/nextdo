# server/powersync local-dev environment (copy to .env and fill in).
# docker-compose.yml interpolates these; service.yaml resolves the PS_*
# values via its own `!env` tag at startup.

# Postgres (the local source DB + the PowerSync bucket storage live in
# this one instance — two databases: POSTGRES_DB and nextdo_powersync).
POSTGRES_USER=nextdo
POSTGRES_PASSWORD=nextdo
POSTGRES_DB=nextdo

# PowerSync JWT shared secret — base64url-encoded, NO padding.
# MUST be the SAME value server/app signs with (JWT_SECRET in
# server/app/.env — the service uses it verbatim as the HS256 JWK `k`).
# Generate:
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
JWT_SECRET=REPLACE_WITH_BASE64URL_SECRET

# PowerSync admin API token (local dev only).
PS_ADMIN_TOKEN=nextdo-admin-dev
