# server/app runtime environment (copy to .env and fill in).

# Postgres DSN of the SOURCE database the upload endpoint applies ps_crud
# batches to (the same database the PowerSync service replicates from —
# see server/powersync/docker-compose.yml).
DATABASE_URL=postgresql://nextdo:nextdo@localhost:5432/nextdo

# Shared owner token — v1 single-user auth. The client stores this per
# platform (SecureStore / stronghold / in-memory); both endpoints 401
# without it. Generate any long random string, e.g.:
#   openssl rand -hex 32
NEXTDO_OWNER_TOKEN=REPLACE_WITH_A_LONG_RANDOM_STRING

# The PUBLIC PowerSync stream URL handed to every device with
# GET /credentials — REQUIRED, absolute http(s). In local dev the service
# listens on 127.0.0.1:8080, so use the loopback value; behind a reverse
# proxy put the public path instead (e.g. https://your.domain/sync).
# The server refuses to start when this is missing/empty/invalid — a
# silently wrong path produces clients that "connect" and never sync.
NEXTDO_SYNC_ENDPOINT=http://localhost:8080

# PowerSync JWT shared secret — base64url-encoded, NO padding.
# MUST be the SAME value the PowerSync service is configured with
# (PS_JWT_SECRET in server/powersync/.env — the service uses it directly as
# the HS256 JWK `k`; this app decodes it to the signing bytes). Generate:
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
JWT_SECRET=REPLACE_WITH_BASE64URL_SECRET

# HTTP port.
PORT=8787
