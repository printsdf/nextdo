{
  "expo": {
    "name": "Nextdo",
    "slug": "nextdo",
    "version": "0.1.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "nextdo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.nextdo.mobile",
      "supportsTablet": false
    },
    "android": {
      "package": "com.nextdo.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f202b"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "7b5502cd-d681-4840-95e3-69d11104cd2b"
      }
    },
    "owner": "printsdf"
  }
}
