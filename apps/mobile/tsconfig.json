{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": [
      "react",
      "nativewind/types",
      "jest"
    ],
    "paths": {
      "@nextdo/core": [
        "../../packages/core/src/index.ts"
      ],
      "@nextdo/db": [
        "../../packages/db/src/index.ts"
      ],
      "@nextdo/ui": [
        "../../packages/ui/src/index.ts"
      ],
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ]
}