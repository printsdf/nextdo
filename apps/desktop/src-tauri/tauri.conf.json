{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "com.nextdo.desktop",
  "productName": "Nextdo",
  "version": "0.1.0",
  "build": {
    "beforeDevCommand": "pnpm --filter @nextdo/mobile run web",
    "devUrl": "http://localhost:8081",
    "beforeBuildCommand": "pnpm --filter @nextdo/mobile exec expo export --platform web && rm -rf src-tauri/frontend-dist && cp -r ../mobile/dist src-tauri/frontend-dist",
    "frontendDist": "http://127.0.0.1:52123"
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "frontend-dist"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
